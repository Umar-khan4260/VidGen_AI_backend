# ============================================================
# Copy this file to `.env` and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored — never commit the real key.
# ============================================================

# KIE.ai platform API key (get it from https://kie.ai)
KIE_API_KEY=your_kie_api_key_here

# Absolute path to the downloaded Firebase service-account key.
# Used only when running the server directly (node src/server.js / npm run dev).
# Docker injects its own path (/app/service-account-key.json) automatically.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json

# Port the Express server listens on (used by docker-compose.yml).
PORT=8080
# NODE_ENV=production

# ============================================================
# Apple App Store Server API v2 (Phase 6 IAP Verification)
# ============================================================
APPLE_ISSUER_ID=your_issuer_id_here
APPLE_KEY_ID=your_key_id_here
# IMPORTANT: Paste the private key as a single line with \n for newlines.
#            Do NOT wrap this value in quotes — Docker env parser breaks on them.
#            Example: APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----
APPLE_BUNDLE_ID=com.vidgen
ALLOW_UNVERIFIED_PURCHASES=true
