# VidGen AI backend — nginx reverse proxy (VPS deployment)
#
# 1. Copy to /etc/nginx/sites-available/vidgen and EDIT server_name
# 2. ln -s /etc/nginx/sites-available/vidgen /etc/nginx/sites-enabled/
# 3. nginx -t && systemctl reload nginx
# 4. certbot --nginx -d api.yourdomain.com   (installs Let's Encrypt SSL)
#
# After certbot runs, re-check this file — certbot edits it to add the
# ssl_certificate lines for you.

server {
    listen 80;
    server_name api.yourdomain.com;   # <-- EDIT: your domain
    # certbot will replace this block with a redirect to https
    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}

