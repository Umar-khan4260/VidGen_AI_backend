# Keep the image clean: never copy local deps, secrets or VCS data.
# Paths are relative to the build context (the backend repo root).

# Local dependencies (host node_modules are Windows-native — must NOT ship)
functions/node_modules
**/node_modules

# Secrets
.env
.env.*
service-account-key.json

# VCS / editor / docs
.git
.gitignore
.vscode
*.md

# Firebase config (not needed at runtime inside the image)
firebase.json
firestore.rules
firestore.indexes.json
