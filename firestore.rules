rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.linkedFirebaseUids;
      allow write: if false;

      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.linkedFirebaseUids;
        allow write: if false;
      }
    }

    match /admin/{document} {
      // ── Fixed rule: Admins only, app clients should NOT be able to read this ──
      allow read, write: if false; 
    }
  }
}
